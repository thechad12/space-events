# Database
POSTGRES_USER=spaceevents
POSTGRES_PASSWORD=spaceevents
POSTGRES_DB=spaceevents

# App
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
NASA_API_KEY=DEMO_KEY

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Web Push (VAPID) — generate with: cd backend && python generate_vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=your@email.com

# Firebase (native iOS/Android push) — paste service account JSON as one line
FIREBASE_CREDENTIALS_JSON=
